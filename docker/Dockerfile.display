FROM ubuntu:24.04 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        ninja-build \
        qt6-base-dev \
        qt6-declarative-dev \
        qml6-module-qtquick \
        qml6-module-qtquick-controls \
        qml6-module-qtquick-layouts \
        qml6-module-qtquick-templates \
        qml6-module-qtqml \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY edge/display /src
RUN cmake -S /src -B /tmp/build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/build \
    && /tmp/build/ogw-display-tests

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        libegl1 \
        libgl1 \
        libqt6core6 \
        libqt6gui6 \
        libqt6network6 \
        libqt6qml6 \
        libqt6quick6 \
        libqt6quickcontrols2-6 \
        libxcb-cursor0 \
        novnc \
        qml6-module-qtqml \
        qml6-module-qtqml-workerscript \
        qml6-module-qtquick \
        qml6-module-qtquick-controls \
        qml6-module-qtquick-layouts \
        qml6-module-qtquick-templates \
        qml6-module-qtquick-window \
        qt6-qpa-plugins \
        websockify \
        x11-utils \
        x11vnc \
        xauth \
        xserver-xephyr \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /tmp/build/ogw-display /usr/local/bin/ogw-display
COPY docker/display-entrypoint.sh /usr/local/bin/ogw-display-entrypoint
RUN chmod +x /usr/local/bin/ogw-display-entrypoint

ENV OGW_API=http://gateway:8080
ENV OGW_UI=novnc
ENV OGW_DISPLAY_CONFIG=/etc/ogw/display.toml
EXPOSE 6080
ENTRYPOINT ["/usr/local/bin/ogw-display-entrypoint"]
