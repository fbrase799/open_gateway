if(NOT BIN)
    message(FATAL_ERROR "BIN is required")
endif()
execute_process(COMMAND ldd "${BIN}" OUTPUT_VARIABLE output RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ldd failed for ${BIN}")
endif()
foreach(plugin temperature_sim motor_sim bad_plugin ogw_test_plugin)
    string(FIND "${output}" "${plugin}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "gateway executable is linked to ${plugin}")
    endif()
endforeach()
